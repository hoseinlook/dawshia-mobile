{
  "expo": {
    "name": "Dawshia",
    "slug": "dawshia",
    "scheme": "dawshia",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0F1A",
    "ios": {
      "bundleIdentifier": "com.dawshia.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Dawshia uses the camera to detect your movement and count your reps. Video never leaves your phone."
      }
    },
    "android": {
      "package": "com.dawshia.app",
      "permissions": [
        "android.permission.CAMERA"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0B0F1A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "usesCleartextTraffic": true,
            "buildArchs": [
              "arm64-v8a"
            ]
          }
        }
      ],
      "expo-screen-orientation",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-asset",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Dawshia uses your photos so you can choose a profile picture.",
          "cameraPermission": "Dawshia uses the camera to detect your movement and count your reps. Video never leaves your phone.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#3DDC97"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/app"
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "favicon": "./assets/favicon.png",
      "name": "Dawshia",
      "shortName": "Dawshia",
      "themeColor": "#0B0F1A",
      "backgroundColor": "#0B0F1A"
    }
  }
}
